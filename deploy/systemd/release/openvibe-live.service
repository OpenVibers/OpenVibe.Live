# Release layout (deploy/scripts/migrate-to-releases.sh). The unit in deploy/systemd/ is the legacy,
# in-place checkout variant and stays valid until a host is migrated.
[Unit]
Description=OpenVibe.Live — Free & Open Live Streaming
# Media (openvibe-media) and Network (openvibe-network) should be up first, but
# Live degrades gracefully if they aren't (proxies 502, wallet reads fall back).
After=network.target
Wants=openvibe-media.service openvibe-network.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.live/current
EnvironmentFile=/etc/openvibe/live.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Static files and docs are read through the `current` link, so a static-only release switch needs no restart.
Environment=OV_APP_ROOT=/opt/openvibe.live/current
ExecStart=/usr/bin/env node /opt/openvibe.live/current/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# NOTE: keep ProtectHome=read-only (NOT true) — the local whisper.cpp install used
# for free VOD/clip transcription lives under the service user's home directory and
# must stay readable, or transcription silently disables itself.
ProtectHome=read-only
# Persistent state lives outside the releases; releases/<id>/data is a link to it.
ReadWritePaths=/opt/openvibe.live/shared/data

[Install]
WantedBy=multi-user.target
