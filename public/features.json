{
  "_comment": "Feature and route registry, read by server/web/assets.js (first paint: which assets the requested route needs) and by public/js/ov-loader.js (navigation: what to load before a route renders). Scripts in a feature run in the listed order, after the feature's dependencies. `fragment` names public/fragments/<name>.html, inserted into section #page-<section> before any of the feature's scripts run. `after` names a global function called once when the feature has loaded. `stubs` are global functions that inline handlers call; until the feature is loaded they load it and then call the real function. See docs/architecture.md#frontend-loading.",
  "features": {
    "chatUI": {
      "_comment": "The chat UI: the socket, the messages, the panels. Only the pages that have chat ask for it (the routes below name it); the part of chat every page needs is public/js/chat-core.js.",
      "css": [
        "/css/chat-shared.css"
      ],
      "js": [
        "/js/chat-shared.js",
        "/js/chat.js"
      ],
      "stubs": [
        "sendChat",
        "toggleChatTTS",
        "toggleChatSettings",
        "toggleChatUsers",
        "toggleChatLimitsPopover",
        "toggleMobileChat",
        "popoutStreamChat",
        "popoutGlobalChat",
        "onChatModeChange",
        "fcwToggle",
        "fcwMinimize",
        "fcwClose",
        "fcwSendChat",
        "fcwStartDrag",
        "fcwStartResize"
      ]
    },
    "home": {
      "fragment": "home",
      "css": [
        "/css/features/home.css",
        "/css/home-fx.css",
        "/css/home-tour.css"
      ],
      "js": [
        "/shared/kit-web.js",
        "/js/ov-rail.js",
        "/js/ov-live-realtime.js",
        "/js/app-home.js",
        "/js/ov-odometer.js",
        "/js/ov-density.js",
        "/js/home-fx.js",
        "/shared/tooltip.js"
      ],
      "idle": [
        "guide",
        "player",
        "channel",
        "chatUI"
      ]
    },
    "feeds": {
      "css": [
        "/css/features/content.css"
      ],
      "js": [
        "/js/content-feed.js"
      ]
    },
    "content": {
      "fragment": "content",
      "deps": [
        "feeds"
      ]
    },
    "moments": {
      "fragment": "moments",
      "deps": [
        "feeds"
      ]
    },
    "clipJobs": {
      "js": [
        "/js/ov-clip-jobs.js"
      ]
    },
    "player": {
      "deps": [
        "clipJobs"
      ],
      "css": [
        "/css/features/pip.css"
      ],
      "js": [
        "/shared/loading.js",
        "/js/player-shape.js",
        "/js/ov-viewer-health.js",
        "/js/ov-mini-player.js",
        "/js/stream-player.js",
        "/js/stream-pip.js"
      ]
    },
    "context": {
      "css": [
        "/css/context-cards.css"
      ],
      "js": [
        "/js/context-cards.js"
      ]
    },
    "chatExtras": {
      "js": [
        "/js/chat-spoilers.js",
        "/js/emotes.js",
        "/js/gif-picker.js",
        "/js/chat-autocomplete.js"
      ],
      "after": "initGifPickers",
      "stubs": [
        "toggleEmotePicker",
        "renderEmotePicker",
        "onEmoteSearch",
        "toggleGifPicker"
      ]
    },
    "uploads": {
      "js": [
        "/js/channel-uploads.js"
      ],
      "stubs": [
        "openChannelUploadModal"
      ]
    },
    "viewerPlaces": {
      "css": [
        "/css/features/viewer-places.css"
      ],
      "js": [
        "/js/viewer-places.js"
      ]
    },
    "channel": {
      "fragment": "channel",
      "css": [
        "/css/features/channel.css",
        "/shared/kit.css",
        "/css/features/agent-stream.css"
      ],
      "deps": [
        "money",
        "player",
        "context",
        "chatExtras",
        "uploads",
        "viewerPlaces"
      ],
      "js": [
        "/js/channel-socials.js",
        "/js/channel-chat-resize.js",
        "/js/channel-support.js",
        "/js/app-channel.js",
        "/js/bench-stream-watch.js",
        "/js/agent-cards.js"
      ],
      "stubs": [
        "toggleChannelChat"
      ]
    },
    "voice": {
      "css": [
        "/css/features/voice.css"
      ],
      "js": [
        "/js/call.js",
        "/js/voice-channels.js"
      ],
      "after": "vcBoot",
      "stubs": [
        "requestMicAccess",
        "vcShowCreateModal",
        "vcHideCreateModal",
        "vcCreateChannel",
        "vcToggleMute",
        "vcToggleCamera",
        "vcToggleSettings",
        "vcLeave",
        "vcSwitchMic",
        "vcSwitchCam",
        "vcOnInputModeChange",
        "vcOnPttKeyChange",
        "vcOnVadChange", "vcToggleScreen", "vcDockCycleSize", "vcOpenFullCall"
      ]
    },
    "chatpage": {
      "fragment": "chat",
      "css": [
        "/css/features/chatpage.css"
      ],
      "deps": [
        "voice",
        "chatExtras"
      ],
      "js": [
        "/js/app-chatpage.js"
      ]
    },
    "aiViewers": {
      "js": [
        "/js/ai-viewers.js"
      ],
      "stubs": [
        "aivCloneChatter"
      ]
    },
    "botEmbed": {
      "js": [
        "/js/bot-embed.js"
      ]
    },
    "botBind": {
      "js": [
        "/js/bot-bind.js"
      ]
    },
    "homeTour": {
      "js": [
        "/js/home-tour.js"
      ]
    },
    "guide": {
      "css": [
        "/css/ov-guide.css",
        "/shared/kit.css"
      ],
      "js": [
        "/js/ov-guide.js",
        "/js/guides-live.js"
      ],
      "stubs": [
        "openSetupHub",
        "startGoLiveJourney",
        "startRestreamGuide",
        "setupNextUp"
      ]
    },
    "broadcast": {
      "fragment": "broadcast",
      "css": [
        "/css/features/broadcast.css",
        "/css/broadcast.css"
      ],
      "deps": [
        "money",
        "chatExtras",
        "guide",
        "aiViewers",
        "clipJobs",
        "viewerPlaces"
      ],
      "js": [
        "/shared/kit-web.js",
        "/js/broadcast-state.js",
        "/js/broadcast-media-setup.js",
        "/js/broadcast-devices.js",
        "/js/call.js",
        "/js/broadcast-workspace.js",
        "/js/broadcast.js",
        "/js/broadcast-cam-pip.js",
        "/js/broadcast-studio.js"
      ]
    },
    "pastes": {
      "js": [
        "/js/pastes.js"
      ],
      "stubs": [
        "captureScreenshot"
      ]
    },
    "money": {
      "js": [
        "/js/vibes.js",
        "/js/opencoins.js"
      ],
      "stubs": [
        "openSubscribeForCurrentStream",
        "openvibeSubscribeModal",
        "showSubscribeModal",
        "toggleRewardsPanel",
        "rewardClick",
        "saveDashPointsConfig"
      ]
    },
    "dashboard": {
      "fragment": "dashboard",
      "css": [
        "/css/features/dashboard.css",
        "/css/broadcast.css"
      ],
      "deps": [
        "money",
        "pastes",
        "aiViewers"
      ],
      "js": [
        "/js/settings.js",
        "/js/dashboard-moderation.js",
        "/js/powerchat.js",
        "/js/dashboard.js",
        "/js/bench-stream-dashboard.js"
      ],
      "stubs": [
        "regenerateDashStreamKey"
      ]
    },
    "rundown": {"fragment": "rundown", "css": ["/css/features/rundown.css"], "js": ["/js/rundown.js"]},
    "recap": {
      "css": [
        "/css/recap.css",
        "/shared/kit.css"
      ],
      "js": [
        "/js/recap.js"
      ]
    },
    "updates": {
      "fragment": "updates"
    },
    "docs": {
      "fragment": "documentation",
      "css": [
        "/css/features/docs.css"
      ],
      "js": [
        "/js/app-docs.js"
      ]
    },
    "statsNerds": {
      "css": [
        "/css/features/stats.css"
      ],
      "js": [
        "/js/stats-nerds.js"
      ],
      "stubs": [
        "openStatsNerds"
      ]
    },
    "featured": {
      "css": [
        "/css/features/featured.css"
      ],
      "js": [
        "/js/home-featured.js"
      ]
    },
    "search": {
      "fragment": "search",
      "css": [
        "/css/features/search.css"
      ],
      "js": [
        "/js/app-search.js"
      ]
    },
    "agent-stream": {
      "fragment": "agent-stream",
      "css": [
        "/css/features/agent-stream.css",
        "/shared/ov-share.css"
      ],
      "js": [
        "/js/agent-player.js",
        "/js/agent-overlay.js",
        "/js/agent-stream.js",
        "/shared/ov-share.js"
      ]
    }
  },
  "routes": [
    {
      "path": "^/$",
      "features": [
        "home"
      ]
    },
    {
      "path": "^/(content|vods|clips|pastes)/?$",
      "features": [
        "content"
      ]
    },
    {
      "path": "^/moments/?$",
      "features": [
        "moments"
      ]
    },
    {
      "path": "^/search/?$",
      "features": [
        "search"
      ]
    },
    {
      "path": "^/dashboard",
      "features": [
        "dashboard"
      ]
    },
    {
      "path": "^/broadcast",
      "features": [
        "chatUI",
        "broadcast"
      ]
    },
    {
      "path": "^/chat",
      "features": [
        "chatUI",
        "chatpage"
      ]
    },
    {
      "path": "^/p/",
      "features": [
        "pastes"
      ]
    },
    {
      "path": "^/recap/",
      "features": [
        "recap"
      ]
    },
    {"path": "^/rundown", "features": ["rundown"]}, {"path": "^/arena", "features": ["rundown"]},
    {"path": "^/updates/?$", "features": ["updates"]},
    {
      "path": "^/documentation",
      "features": [
        "docs"
      ]
    },
    {
      "path": "^/stream/",
      "features": [
        "chatUI",
        "channel"
      ]
    },
    {
      "path": "^/@[A-Za-z0-9_]+/agents/",
      "features": [
        "agent-stream"
      ]
    },
    {
      "path": "^/@",
      "features": [
        "chatUI",
        "channel"
      ]
    }
  ]
}
