# OpenVibe.Live Configuration
# Copy this to .env and fill in your values.
# Production env file lives at /etc/openvibe/live.env (mode 0600).

# Platform Admin — username of the site owner (applied on first setup only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Home-page "Star of OpenVibe" spotlight — a username. The `star_streamer` site setting
# (admin settings API) overrides this. Non-English streamers get their bio auto-translated.
# STAR_STREAMER=JapaneseOldGuy

# Multilingual whisper.cpp model for non-English streamers (chat + live captions + timeline).
# The default *.en models can only emit English. Download e.g. ggml-base.bin / ggml-small.bin
# (no ".en") into ~/whisper.cpp/models and point this at it. Without it, non-English
# channels keep using the English model and live captions stay hidden.
# WHISPER_MODEL_MULTI=/home/openvibe/whisper.cpp/models/ggml-small.bin

# OpenVibe.AI (roadmap Wave 13). AI_SERVICE=remote sends Live's shared-key AI calls (chat AI, moments,
# paste/frame analysis, overviews, translation, recaps, slogans, arena, footer copy) to the AI service as
# workflow runs, with a service token for audience openvibe.ai (grant ai.run.create for client `live`).
# The admin ai_enabled switch and the local daily cap still apply; the provider key lives in the AI
# service. Streamer BYO keys and local whisper.cpp transcription stay here. Unset = Live calls
# providers itself, exactly as before.
#AI_SERVICE=remote
#OV_AI_INTERNAL_URL=http://127.0.0.1:4700

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000

# JWT Secret (generate a strong random string)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Database
DB_PATH=./data/live.db

# ── OpenVibe.Network (SSO provider + OpenCoins wallet + URL registry) ─────────
# Public base of the identity provider (issuer for RS256 JWTs)
OV_NETWORK_URL=https://openvibe.network
# Internal (server-to-server) base — wallet API + /internal/* endpoints
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OAuth client credentials (client id `live` is seeded in the Network DB)
OV_OAUTH_CLIENT_ID=live
OV_OAUTH_CLIENT_SECRET=
# Per-service key for Network's /internal/* endpoints (header X-Internal-Key)
INTERNAL_API_KEY=change-me-to-a-random-secret
# Legacy openvibe-quest game-item bridge (cosmetics ⇄ game inventory). Off unless set; authenticated with INTERNAL_API_KEY.
# LEGACY_QUEST_API_URL=http://127.0.0.1:3200
# OpenVibe.Events (durable events): stream lifecycle is published through Live's outbox with the
# OAuth client above (grant events.event.publish). Unset = off. EVENTS_PUBLISH=off also disables it.
#EVENTS_URL=http://127.0.0.1:4300

# OpenRe.Stream (roadmap Wave 7): the ingest/restream authority. Unset = off, and every stream slot
# is ingested by Live exactly as before. When set, an admin can switch one slot at a time
# (PUT /api/admin/openre/managed/:id/ingest-authority); only RTMP moves. Live's service principal
# (the OAuth client above) needs openre.stream.read, openre.stream.write, openre.key.rotate and
# openre.session.read on audience openvibe.openre.
#OPENRE_URL=http://127.0.0.1:4500
#OPENRE_PUBLIC_URL=https://openre.stream
# Secret of Live's OpenVibe.Events subscription to openre.session.* (endpoint
# http://127.0.0.1:3000/internal/openre-events); sessions are mirrored into `streams` from it.
#OPENRE_EVENTS_SECRET=
# Path to the Network's RS256 public key (offline JWT verification)
#OV_NETWORK_PUBLIC_KEY=./data/keys/openvibe-network-public.pem

# ── OpenVibe.Media (VODs / clips / pastes / thumbnails service) ───────────────
# Internal API base (server-to-server, Bearer MEDIA_API_KEY)
MEDIA_URL=http://127.0.0.1:4100
# Public serving base (playback/thumbnail/paste URLs handed to browsers)
MEDIA_PUBLIC_URL=https://openvibe.media
# Tenant id — an app key only works for its own tenant
MEDIA_APP_ID=live
# Live's per-app server key for the Media API
MEDIA_API_KEY=
# Shared secret for verifying Media → Live webhooks (X-OVMedia-Signature HMAC)
MEDIA_WEBHOOK_SECRET=

# ── RTMP ingest ───────────────────────────────────────────────────────────────
RTMP_PORT=1935
RTMP_CHUNK_SIZE=60000
# Public ingest hostname shown to streamers (rtmp://<host>/live)
RTMP_HOST=ingest.openvibe.live

# JSMPEG Relay
JSMPEG_VIDEO_PORT=9710
JSMPEG_AUDIO_PORT=9711

# WebRTC / Mediasoup
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100
WEBRTC_PORT=4443

# TURN Server (coturn) — required for NAT traversal
TURN_URL=turn:turn.openvibe.live
TURN_USERNAME=
TURN_CREDENTIAL=
# Preferred: coturn `use-auth-secret` + `static-auth-secret=<this>` — every ICE list then carries a
# credential that expires after an hour instead of the static pair above.
TURN_AUTH_SECRET=
ALLOW_P2P_FALLBACK=false

# PayPal (for Vibes cashout — Vibes stay Live-local)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Vibes
MIN_CASHOUT_BUCKS=500
ESCROW_HOLD_DAYS=14

# Live-local media state (VOD/clip/paste FILES live in OpenVibe.Media now)
# Ephemeral live-stream thumbnails
LIVE_THUMBS_PATH=./data/live-thumbs
# Song-request media cache (yt-dlp downloads for the watch-party queue)
# lives under ./data/media/cache — no env needed.
# Max size of a browser VOD upload forwarded to Media
MAX_VOD_SIZE_MB=2048

# Word Filter
UNSAFE_WORDS_PATH=./server/chat/unsafe-words.txt

# Ops alerts (optional) — Discord-compatible webhook that receives storage alerts relayed
# from OpenVibe.Media (drain stalled / disk critical / recovered). Can also be set from the
# admin settings as `ops_alert_webhook_url`.
OPS_ALERT_WEBHOOK_URL=

# Pastes are served by openvibe.community when this is 1 (Live 301s /p/:slug and /pastes there)
PASTES_ON_COMMUNITY=0
OV_COMMUNITY_URL=https://openvibe.community

# Chat runs in OpenVibe.Chat when this is "chat" (roadmap W6; server/chat/chat-authority.js): Live
# stops serving /ws/chat and /api/chat|dm|tts|sounds (nginx sends them to Chat), forwards its own
# chat calls to Chat and keeps its chat tables as Chat's read mirror. Unset = Live runs chat.
#CHAT_AUTHORITY=chat
OV_CHAT_INTERNAL_URL=http://127.0.0.1:4400

# Money authority (roadmap Wave 8, ADR-012). live (default): Live's own Vibes columns, exactly as
# before. billing: OpenVibe.Billing is the ledger — Live calls it for checkouts, donations, cashouts,
# recycling, subscriptions, balances and entitlements with its service token (audience
# openvibe.billing) and never writes its legacy money columns; the provider/PowerChat webhooks on
# Live answer 410. Unset = live. Cutover procedure: docs/live-cutover.md in OpenVibe.Billing.
#BILLING_AUTHORITY=billing
OV_BILLING_INTERNAL_URL=http://127.0.0.1:4600
OV_BILLING_PUBLIC_URL=https://billing.openvibe.network
# OV_BILLING_TIMEOUT_MS=8000
